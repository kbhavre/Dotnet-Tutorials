<h2>Login Page</h2>

<form asp-action="Login"
      method="post">

    <div class="mb-3">

        <label>User Name</label>

        <input type="text"
               name="username"
               class="form-control" />

    </div>

    <button type="submit"
            class="btn btn-primary">

        Login

    </button>

</form>