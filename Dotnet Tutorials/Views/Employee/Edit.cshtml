@model Dotnet_Tutorials.Models.EmployeeModel

@{
    ViewData["Title"] = "Edit Employee";
}

<div class="container mt-5">

    <div class="card shadow p-4">

        <h2 class="mb-4">
            Edit Employee
        </h2>

        <form method="post">

            <input type="hidden"
                   asp-for="Id" />

            <div class="mb-3">

                <label class="form-label">
                    Employee Name
                </label>

                <input type="text"
                       asp-for="Name"
                       class="form-control" />

                <span asp-validation-for="Name"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Department
                </label>

                <input type="text"
                       asp-for="Department"
                       class="form-control" />

                <span asp-validation-for="Department"
                      class="text-danger">
                </span>

            </div>

            <div class="mb-3">

                <label class="form-label">
                    Salary
                </label>

                <input type="number"
                       asp-for="Salary"
                       class="form-control" />

                <span asp-validation-for="Salary"
                      class="text-danger">
                </span>

            </div>

            <button type="submit"
                    class="btn btn-warning">

                Update Employee

            </button>

            <a asp-action="Index"
                   class="btn btn-secondary">

                Back

            </a>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}