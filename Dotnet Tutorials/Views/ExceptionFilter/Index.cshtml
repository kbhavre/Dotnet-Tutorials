<h1>Exception Filter Demo</h1>

<form asp-action="Divide" method="post">
    <div class="mb-3">
        <label>Enter the value of X</label>

        <input type="number" name="x" class="form-control" />
    </div>

    <div class="mb-3">
        <label>Enter the value of Y</label>
        <input type="number" name="y" class="form-control"/>
    </div>

    <button type="submit" class="btn btn-primary">Divide</button>
</form>


