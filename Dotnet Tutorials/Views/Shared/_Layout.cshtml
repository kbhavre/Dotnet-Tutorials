<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dotnet_Tutorials</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Dotnet_Tutorials.styles.css" asp-append-version="true" />
    <style>
            /* Open dropdown on hover */
            .nav-item.dropdown:hover > .dropdown-menu {
                display: block;
                margin-top: 0;
            }
    </style>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">Dotnet_Tutorials</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">

                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle"
                                   asp-area="" asp-controller="Home" asp-action="Index"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Home
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">Dashboard</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">Latest Posts</a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Home" asp-action="Index">Featured</a>
                                </li>
                            </ul>
                        </li>


                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle"
                                   asp-area="" asp-controller="Middleware" asp-action="Index"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Middlewares
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Middleware" asp-action="Index">Introduction</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Middleware" asp-action="AppRun">App.Run()</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Middleware" asp-action="AppMap">App.Map()</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Middleware" asp-action="ExecutionTimeMiddleware">Execution Time</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Middleware" asp-action="IpAddressMiddleware">IP Address</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="Middleware" asp-action="RequestLoggingMiddleware">Request Logging</a>
                                </li>
                               
                            </ul>
                        </li>


                        <li class="nav-item dropdown">
                            <a class="nav-link text-dark dropdown-toggle"
                                   asp-area="" asp-controller="Home" asp-action="ActionFilters"
                                   role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Action Filters
                            </a>
                            <ul class="dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="LoggerFilter" asp-action="Index">API Request Logger</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="ValidationFilter" asp-action="Index">Custom Validation</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="AuthorizationFilter" asp-action="Dashboard">Authorization</a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-area="" asp-controller="ExceptionFilter" asp-action="Index">Exception Handling Filter</a>
                                </li>
                            </ul>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Dotnet_Tutorials - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>