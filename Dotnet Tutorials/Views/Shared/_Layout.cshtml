<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Dotnet Tutorials</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Dotnet_Tutorials.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/faq.css" />
</head>

<body>

    <!-- Navbar -->

    <nav class="navbar navbar-expand-lg navbar-dark custom-navbar">

        <div class="container-fluid">

            <!-- Brand -->

            <a class="navbar-brand fw-bold"
                   asp-controller="Home"
                   asp-action="Index">

                Dotnet Tutorials

            </a>

            <!-- Mobile Toggle -->

            <button class="navbar-toggler"
                    type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- Navbar Content -->

            <div class="collapse navbar-collapse"
                 id="navbarContent">

                <ul class="navbar-nav ms-auto">

                    <!-- Home -->

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button">Home</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Home" asp-action="Index">Dashboard</a> </li>
                        </ul>
                    </li>

                    <!-- C# Basics -->

                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button">C# Basics</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="CSharpBasics" asp-action="TypesOfClasses">Types Of Classes</a> </li>
                            <li><a class="dropdown-item" asp-controller="CSharpBasics" asp-action="TypesOfMethods">Types Of Methods</a> </li>
                            <li><a class="dropdown-item" asp-controller="CSharpBasics" asp-action="GotoStatement">Goto Statement</a> </li>
                            <li><a class="dropdown-item" asp-controller="CSharpBasics" asp-action="RefKeyword">Ref Keyword</a> </li>
                            <li><a class="dropdown-item" asp-controller="CSharpBasics" asp-action="OutKeyword">Out Keyword</a> </li>
                            <li><a class="dropdown-item" asp-controller="CSharpBasics" asp-action="CheckUncheck">Check & Uncheck Keyword</a> </li>
                            <li><a class="dropdown-item" asp-controller="CSharpBasics" asp-action="BoxingUnboxing">Boxing & Unboxing</a> </li>
                        </ul>
                    </li>

                    <!-- MVC Basics -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button">MVC Basics</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="MVCBasics" asp-action="ImpQuestions">Important Questions</a></li>
                            <li><a class="dropdown-item" asp-controller="MVCBasics" asp-action="Index">Introduction</a></li>
                            <li><a class="dropdown-item" asp-controller="MVCBasics" asp-action="ControllersAndActions">Controllers and Actions</a></li>
                            <li><a class="dropdown-item" asp-controller="MVCBasics" asp-action="DependencyInjection">Dependency Injection</a></li>
                        </ul>
                    </li>

                    <!-- Routing -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button">Routing</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Routing" asp-action="Index">Introduction</a></li>
                            <li><a class="dropdown-item" asp-controller="Routing" asp-action="ConventionalRouting">Conventional Routing</a></li>
                            <li><a class="dropdown-item" asp-controller="Routing" asp-action="AttributeRouting">Attribute Routing</a></li>
                            <li><a class="dropdown-item" asp-controller="Routing" asp-action="RouteParameters">Route Parameters</a></li>
                            <li><a class="dropdown-item" asp-controller="Routing" asp-action="RouteConstraints">Route Constraints</a></li>
                            
                        </ul>
                    </li>

                    <!-- Mpsedc Exam -->
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle" href="#" role="button">Mpsedc Exam</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" asp-controller="Student" asp-action="Index">Calculate Result</a></li>
                            <li><a class="dropdown-item" asp-controller="SimpleInterest" asp-action="Index">Calculate Simple Interest</a></li>
                            <li><a class="dropdown-item" asp-controller="Employee" asp-action="Index">Employee Crud</a></li>
                            <li><a class="dropdown-item" asp-controller="Attendance" asp-action="Index">Attendance Calculator</a></li>
                            <li><a class="dropdown-item" asp-controller="ShoppingCart" asp-action="Index">Shopping Cart Controller</a></li>
                           
                        </ul>
                    </li>

                    <!-- Middleware -->

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button">
                            Middlewares
                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                <a class="dropdown-item"
                                       asp-controller="Middleware"
                                       asp-action="Index">

                                    Introduction

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                       asp-controller="Middleware"
                                       asp-action="AppRun">

                                    App.Run()

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                       asp-controller="Middleware"
                                       asp-action="AppMap">

                                    App.Map()

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                       asp-controller="Middleware"
                                       asp-action="ExecutionTimeMiddleware">

                                    Execution Time

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                       asp-controller="Middleware"
                                       asp-action="IpAddressMiddleware">

                                    IP Address

                                </a>
                            </li>

                        </ul>

                    </li>

                    <!-- Action Filters -->

                    <li class="nav-item dropdown">

                        <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button">

                            Action Filters

                        </a>

                        <ul class="dropdown-menu">

                            <li>
                                <a class="dropdown-item"
                                       asp-controller="LoggerFilter"
                                       asp-action="Index">

                                    API Logger

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                       asp-controller="ValidationFilter"
                                       asp-action="Index">

                                    Validation Filter

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                       asp-controller="AuthorizationFilter"
                                       asp-action="Dashboard">

                                    Authorization

                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item"
                                       asp-controller="ExceptionFilter"
                                       asp-action="Index">

                                    Exception Filter

                                </a>
                            </li>

                        </ul>

                    </li>

                </ul>

            </div>

        </div>

    </nav>

    <!-- Main Content -->

    <div class="container py-5">

        @RenderBody()

    </div>

    <!-- Footer -->

    <footer class="footer">

        <div class="container d-flex justify-content-between flex-wrap">

            <div>

                <h5 class="fw-bold mb-1">
                    Dotnet Tutorials
                </h5>

                <p class="text-muted mb-0">
                    Learn ASP.NET Core MVC with practical examples.
                </p>

            </div>

            <div>

                <a asp-controller="Home"
                       asp-action="Privacy"
                       class="footer-link">

                    Privacy

                </a>

            </div>

        </div>

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/faq.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>