@model Dotnet_Tutorials.Models.ShoppingCartModel

@{
    ViewData["Title"] = "Shopping Cart Total Calculator";
}

<div class="container mt-5">
    <div class="card shadow p-4">
        <h2 class="text-center mb-4">Shopping Cart Calculator</h2>

        <form method="post">
            <div class="mb-3">
                <label class="form-label">Product Name</label>
                <input type="text" asp-for="ProductName" class="form-control"/>
                <span asp-validation-for="ProductName" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Product Price</label>
                <input type="number" asp-for="Price" class="form-control"/>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label class="form-label">Quantity</label>
                <input type="number" asp-for="Quantity" class="form-control"/>
                <span asp-validation-for="Quantity" class="text-danger"></span>
            </div>

            <button class="btn btn-primary w-100" type="submit">Calculate Bill</button>
        </form>

        @if(Model != null && Model.TotalBill > 0)
        {
            <div class="mt-4">
                    <h4 class="text-sucess">Shopping Bill</h4>
                    <table class="table table-bordered mt-3">
                        <tr>
                            <th>Product Name</th>
                            <td>@Model.ProductName</td>
                        </tr>
                        <tr>
                            <th>Price</th>
                            <td>@Model.Price</td>
                        </tr>
                        <tr>
                            <th>Quantity</th>
                            <td>@Model.Quantity</td>
                        </tr>
                        <tr>
                            <th>Total Bilil</th>
                            <td>@Model.TotalBill</td>
                        </tr>
                    </table>
            </div>
        }
    </div>

</div>

@section Scripts{
@{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}